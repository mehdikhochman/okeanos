# Copy to .env and fill in. Never commit .env.
# Locally, the defaults below are enough. On Vercel, set these in Settings > Environment Variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# The exact address customers use. On Vercel it is detected automatically unless you use a custom domain.
PUBLIC_ORIGIN=http://localhost:3000
# Local mode: where the SQLite file and the photos live. Back this folder up.
DATA_DIR=./data
# Set to true behind a reverse proxy (Caddy, nginx). Always on for Vercel.
TRUST_PROXY=false

# --- Vercel (or to work against the production data from your computer) ---
# Added by connecting a Turso database to the Vercel project.
# TURSO_DATABASE_URL=libsql://okeanos-yourname.turso.io
# TURSO_AUTH_TOKEN=
# Added by connecting a Vercel Blob store to the project.
# BLOB_READ_WRITE_TOKEN=

# First admin account, created by `npm run setup` (runs on every Vercel deploy) if none exists.
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=at-least-12-characters
# OWNER_NAME=Your Name

# Optional: secret used to hash visitor IPs. Defaults to a key derived from TURSO_AUTH_TOKEN.
# IP_HASH_SECRET=
