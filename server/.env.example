# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# The exact address customers use, e.g. https://okeanos.com (required in production).
PUBLIC_ORIGIN=http://localhost:3000
# Where the database and uploaded images live. Back this folder up.
DATA_DIR=./data
# Set to true when running behind a reverse proxy (Caddy, nginx) that sets X-Forwarded-For.
TRUST_PROXY=false
# Random secret used to hash visitor IPs in order requests (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
